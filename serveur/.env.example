# --- Espace atelier Typo Cao (service autonome) ---

# Numéros WhatsApp autorisés à entrer dans l'espace atelier, format E.164.
# Plusieurs numéros possibles, séparés par des virgules : chacun reçoit
# son code de connexion sur son propre WhatsApp.
TYPO_CAO_WHATSAPP_TO=+33665433314,+33600000000

# Clé GitHub fine-grained limitée au dépôt du catalogue (Contents : read/write)
TYPO_CAO_GITHUB_TOKEN=github_pat_...

# Chaîne aléatoire (64 caractères hex) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TYPO_CAO_SESSION_SECRET=

# --- Moteur WhatsApp : recopier les MÊMES valeurs que le serveur existant ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Optionnel (valeurs par défaut correctes) ---
# PORT=8787
# TYPO_CAO_ORIGINE=https://nraboudi-beep.github.io
# TYPO_CAO_GITHUB_REPO=Nraboudi-beep/typo-cao
# TYPO_CAO_GITHUB_BRANCHES=typo-cao,main
# TYPO_CAO_OTP_TEMPLATE=typo_cao_code
# TYPO_CAO_OTP_TEMPLATE_LANGUAGE=fr
